# Copy to .env and adjust for your machine. All values shown are defaults.

# Whisper model size: tiny | base | small | medium | large-v3 (bigger = slower + more accurate)
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# CPU threads faster-whisper/CTranslate2 uses for one job. Default heuristic is
# (logical_cpus // 2 - 1). On a 6-core/12-thread Ryzen 5 Mobile that is 5 --
# leaving headroom so the API stays responsive to GET /transcribe polling while
# a job runs. Tune per machine if needed.
# WHISPER_CPU_THREADS=5

MAX_UPLOAD_SIZE_MB=500
FFMPEG_TIMEOUT_SEC=600

# Max jobs waiting in the queue (not counting the one being processed).
# New uploads get HTTP 429 once this many are queued -- protects disk space
# and keeps backlog wait times bounded on a single-worker server.
MAX_QUEUED_JOBS=5

# JOBS_DIR=./jobs
# TMP_DIR=./tmp
